# Provider API keys (already present in Render from the prior project).
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
SUNO_API_KEY=
# Override only if your Suno provider base differs:
SUNO_API_BASE=https://api.sunoapi.org
ELEVENLABS_API_BASE=https://api.elevenlabs.io

# Cloudflare R2 (S3-compatible).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: set explicitly to override the derived endpoint.
R2_ENDPOINT=
# Public base URL for serving artifacts (public bucket or custom domain).
R2_PUBLIC_BASE_URL=

# Local dev only: where artifacts go when R2 is not configured.
LOCAL_STORAGE_DIR=./.artifacts
